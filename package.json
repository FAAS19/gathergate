{
  "name": "gathergate",
  "version": "1.0.0",
  "description": "Self-hosted magic-link client document checklist, deterministic validator, and auto-chaser.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "gathergate": "./dist/index.js"
  },
  "files": [
    "dist",
    "client/dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FAAS19/gathergate.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "build:demo": "npm --prefix client run build:demo",
    "build:site": "npm --prefix site run build",
    "build:docs": "npm --prefix docs run build",
    "build:pages": "npm run build:site && npm run build:demo && npm run build:docs",
    "build:cf": "npm run build:pages && node site/scripts/prepare-cf-output.mjs",
    "build:server": "tsc",
    "build": "npm run build:client && npm run build:server",
    "typecheck": "tsc --noEmit && npm --prefix client run typecheck",
    "start": "node dist/index.js",
    "test": "tsx --test tests/*.test.ts && npm --prefix client test",
    "test:e2e": "npm run build && playwright test",
    "test:pages": "npm run build:pages && playwright test --config playwright.pages.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.21",
    "nodemailer": "^10.6.1",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.4",
    "typescript": "^7.0.2"
  }
}
