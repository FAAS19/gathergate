# GatherGate Configuration
PORT=3080
HOST=127.0.0.1
BASE_URL=http://localhost:3080

# Optional on first boot: auto-generated in DATA_DIR/.master.key if unset.
# For production, generate a 32-byte hex key and set MASTER_KEY here:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# Set true only behind a trusted reverse proxy (Caddy, Nginx, Cloudflare) so rate limits use forwarded client IPs
TRUST_PROXY=false

# Local SQLite database and encrypted blob directory
DATA_DIR=./data

# Tenancy mode: false = single-workspace self-hosted (default), true = multi-tenant hosted
MULTI_TENANT=false

# Optional hosted free-tier caps (0 = unlimited, used when plan is 'free')
FREE_MAX_ACTIVE_REQUESTS=5
FREE_MAX_STORAGE_BYTES=1073741824

# Storage backend: "local" (default) or "s3" (S3 / Cloudflare R2 / MinIO)
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email backend: "console" (default dev fallback), "smtp", or "resend"
EMAIL_BACKEND=console
EMAIL_FROM=GatherGate <noreply@localhost>

# Resend settings (when EMAIL_BACKEND=resend)
RESEND_API_KEY=

# SMTP settings (when EMAIL_BACKEND=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Background job cadence (minutes, 0 disables in-process cron)
CRON_INTERVAL_MINUTES=15

# Default auto-purge retention window (days after completion or expiry; TFN/Medicare packs auto-default to 14)
DEFAULT_PURGE_DAYS=30
